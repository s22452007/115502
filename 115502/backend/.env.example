# ==========================================================
# 環境變數範本
# ==========================================================
# 使用方式：
#   1. 複製這個檔案並改名為 .env（放在 backend/ 資料夾底下）
#         Windows：  copy .env.example .env
#         Mac/Linux：cp .env.example .env
#   2. 把下面的 <貼上你的金鑰> 換成真正的 API 金鑰
#
# ⚠️ .env 內含真實金鑰，「絕對不要」commit 到 git！
#    （backend/.gitignore 已經擋住了，請不要移除該規則）
#    要把金鑰給組員，請用私訊等方式傳送，不要放進 repo。
# ==========================================================


# ----------------------------------------------------------
# Gemini API 金鑰（每個 AI 功能各自一把，額度互不影響）
# ----------------------------------------------------------
# 申請網址：https://aistudio.google.com/apikey
#   1. 登入 Google 帳號
#   2. 點「Create API key」→ 選「Create API key in new project」
#   3. 複製產生的金鑰貼到下面
#
# 🔑 重要：BACKUP（備用）金鑰請用「不同的 Google 帳號」申請！
#    額度是綁 Google 帳號的，同一個帳號開再多把金鑰，
#    額度還是共用同一份，等於沒有備用效果。
#    建議做法：組員每人用自己的帳號申請一把，分散使用。
#
# 💡 沒填的欄位會自動往下找可用的金鑰，
#    所以一開始只填 GEMINI_API_KEY 也能運作，之後再慢慢補齊。

# 拍照辨識單字（相機 → AI 分析照片）
GEMINI_KEY_CAMERA=<貼上你的金鑰>
GEMINI_KEY_CAMERA_BACKUP=<貼上備用金鑰，用不同 Google 帳號申請>

# AI 對話（情境角色扮演、腔調對話）
GEMINI_KEY_TUTOR=<貼上你的金鑰>
GEMINI_KEY_TUTOR_BACKUP=<貼上備用金鑰，用不同 Google 帳號申請>

# 情境例句（依使用者描述的情境生成專屬例句）
GEMINI_KEY_CONTEXT=<貼上你的金鑰>
GEMINI_KEY_CONTEXT_BACKUP=<貼上備用金鑰，用不同 Google 帳號申請>

# 文章語音評分（唸文章 → AI 評分發音）
GEMINI_KEY_ARTICLE=<貼上你的金鑰>
GEMINI_KEY_ARTICLE_BACKUP=<貼上備用金鑰，用不同 Google 帳號申請>


# ----------------------------------------------------------
# 舊版共用金鑰（相容用，可留空）
# ----------------------------------------------------------
# 上面的功能專用金鑰若沒設定，系統會自動改用這兩把。
# 新專案建議直接填上面的功能專用金鑰，這兩個可以不用管。
GEMINI_API_KEY=<貼上你的金鑰>
GEMINI_API_KEY_camara=<貼上你的金鑰>


# ==========================================================
# 補充說明
# ==========================================================
# ● 不需要 Google Cloud TTS 金鑰：
#   語音朗讀（TTS）使用 gTTS，免費且不需要任何金鑰。
#
# ● 不需要語音輸入金鑰：
#   語音轉文字使用裝置／瀏覽器內建功能，不經過後端。
#
# ● 額度用完了怎麼辦？
#   系統會自動切換到 BACKUP 金鑰；若全部用完，
#   畫面會顯示「今日的 OO 服務已達使用上限」，
#   其他不依賴 AI 的功能（單字探險、測驗、徽章等）仍可正常使用。
# ==========================================================
